<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi ini HANYA dipakai varian debug. Varian release memakai
  src/main/res/xml/network_security_config.xml yang menolak seluruh cleartext.

  Hanya varian debug yang mengizinkan HTTP. AppConfig tetap membatasi host ke
  loopback, emulator alias, atau rentang IP privat RFC 1918. Jangan memakai
  build debug untuk akun/data nyata pada jaringan yang tidak dipercaya.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
