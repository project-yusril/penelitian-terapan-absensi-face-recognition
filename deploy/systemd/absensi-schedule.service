[Unit]
Description=Run Absensi Mahasiswa Laravel scheduler
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/absensi/current/backend
EnvironmentFile=/etc/absensi/absensi.env
ExecStart=/usr/bin/php artisan schedule:run
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/absensi/shared/storage /srv/absensi/current/backend/bootstrap/cache
